{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/herb-detail.html",
      "has": [
        {
          "type": "query",
          "key": "herb",
          "value": "(?<slug>[a-z0-9]+(?:-[a-z0-9]+)*)"
        }
      ],
      "destination": "/herbs/:slug",
      "statusCode": 301
    }
  ]
}
