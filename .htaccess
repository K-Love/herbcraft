Options -MultiViews
RewriteEngine On

# Preserve old bookmarks. Slugs cannot contain URL control characters.
RewriteCond %{QUERY_STRING} ^herb=([a-z0-9]+(?:-[a-z0-9]+)*)$ [NC]
RewriteRule ^herb-detail(?:\.html)?$ /herbs/%1 [R=301,L,QSD]

# Redirect only browser requests, not internal rewrites.
RewriteCond %{THE_REQUEST} \s/+([^?\ ]+)\.html[?\ ]
RewriteRule ^ /%1 [R=301,L,NE]

# Serve existing generated HTML; missing profiles remain real 404s.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [END]
